# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/BrandHive?retryWrites=true&w=majority

# Security Secrets (JWT)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGIN=*

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Configuration
EMAIL=brandhive08@gmail.com
EMAIL_PASSWORD=your_email_app_password
